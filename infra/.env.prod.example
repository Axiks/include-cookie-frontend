# ─────────────────────────────────────────────────────────
#  include-cookie-frontend — PROD deploy env
#
#  This is NOT the root .env.example. That one is for local `npm run dev` (localhost URLs,
#  no tunnel). This file is what infra/docker-compose.yml + docker-compose.prod.yml
#  actually read for a deployed stack.
#
#    cp infra/.env.prod.example infra/.env.prod    # then fill every value below
#
#  Copy it to the server next to the compose files. It is gitignored — never commit it.
#
#  NOT in this file — docker-compose.prod.yml sets these itself, anything you put here for
#  them is silently ignored (compose `environment:` beats `env_file`):
#    CATALOG_API_URL / AUTH_SERVICE_URL / BOT_API_URL / S3_ENDPOINT / NODE_ENV
#
#  This app has NO database and NO login of its own — no DB URL, no AUTH_SECRET, no
#  Kratos/Hydra config here. Identity lives in Kratos and is reached only through
#  lumi-auth, server-side.
# ─────────────────────────────────────────────────────────

# ── Docker / networking ──────────────────────────────────
# Image tag to run. Leave commented out (⇒ latest). Only uncomment to pin a commit SHA
# that CI has actually pushed — see the APP_VERSION warning in docker-compose.prod.yml.
#APP_VERSION=

# The lumispace stack's Docker network, so catalog/auth/rustfs resolve by service name.
# It must ALREADY EXIST (that stack creates it) — check with `docker network ls`.
# Default matches a lumispace prod deploy run as `-p pandc`.
LUMISPACE_NETWORK=pandc_default

# ── Cloudflare Tunnel — this app's own ingress ────────────
# Cloudflare Zero Trust → Tunnels → your tunnel → token. Route the public hostname to
# `http://frontend:3000`. Without this the site has no public entrypoint: this repo now
# deploys itself, so it no longer rides on the lumispace stack's tunnel.
TUNNEL_TOKEN=<cloudflared tunnel token>

# ── Catalog (REST) — the projects catalog: listings, project pages, home block ──
# Shared secret; must match CATALOG_INTERNAL_KEY in the lumispace stack's .env.prod.
# Blank/mismatched = catalog sections degrade (empty listings), app still serves.
CATALOG_INTERNAL_KEY=change-me

# ── Auth service (lumi-auth, REST) — hydrates contributor nicknames/avatars ──
# Shared secret; must match AUTH_INTERNAL_KEY in lumi-auth's deploy. Blank = project cards
# render without contributor profile info.
AUTH_INTERNAL_KEY=change-me

# ── Bot (REST) — optional: scope the whole catalog to one Telegram community ──
# Must match BOT_INTERNAL_KEY in the lumispace stack. Leave COMMUNITY_TG_CHAT_ID BLANK to
# disable this entirely (the default) — every project is shown. If set but the bot/chat
# isn't reachable, listings go EMPTY (fail-closed), not "show everything".
BOT_INTERNAL_KEY=change-me
COMMUNITY_TG_CHAT_ID=

# ── Object storage (S3 / RustFS) — serves avatar/cover image bytes at /cdn/* ──
# Must match the lumispace stack's RustFS credentials (compose defaults both to
# rustfsadmin). Unreachable = broken image icons, not a crash.
RUSTFS_ACCESS_KEY=change-me
RUSTFS_SECRET_KEY=change-me
S3_BUCKET=pandc

# ── Misc ─────────────────────────────────────────────────
# Kill-switch for the read-only projects catalog (nav link, home block, /project pages).
# Unset/on = shown; off = hidden.
DYNAMIC_FEATURES=on

# Analytics (optional) — pageview script, rendered only when BOTH are set. The Umami
# server itself lives in the lumispace stack; create a SEPARATE website there for this app
# and paste its id here. Blank = analytics off.
UMAMI_SRC=
UMAMI_WEBSITE_ID_WEB=
