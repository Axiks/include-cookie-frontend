# ─────────────────────────────────────────────────────────
#  include-cookie-frontend — DEV deploy env (remote dev stack)
#
#    cp infra/.env.dev.example infra/.env.dev    # then fill every value below
#
#  Same shape as .env.prod.example — see that file's header for the full explanation of
#  what lives here vs. what docker-compose sets itself. Differences from prod:
#    - attaches to lumispace's DEV network (`-p pandc-dev` ⇒ pandc-dev_default)
#    - image tag is fixed to :dev by the overlay (no APP_VERSION knob)
#    - its own tunnel token / hostname, separate from prod's
#
#  For plain LOCAL development you don't need this file at all — use a root .env.local
#  (see .env.example) and `npm run dev`.
#
#  Gitignored — never commit it.
# ─────────────────────────────────────────────────────────

# ── Docker / networking ──────────────────────────────────
# lumispace's DEV stack network — must already exist (`docker network ls`).
LUMISPACE_NETWORK=pandc-dev_default

# ── Cloudflare Tunnel — this app's own dev ingress ────────
# Use a tunnel/hostname SEPARATE from prod's (e.g. web-dev.example.com).
TUNNEL_TOKEN=<cloudflared tunnel token for the dev hostname>

# ── Shared secrets — must match the lumispace DEV stack / lumi-auth dev deploy ──
# Every one of these is independently optional: a blank or mismatched key degrades only
# its own feature, it never stops the app from serving.
CATALOG_INTERNAL_KEY=change-me
AUTH_INTERNAL_KEY=change-me
BOT_INTERNAL_KEY=change-me

# Optional: scope the catalog to one Telegram community's members. Blank = disabled
# (every project shown). Set = fail-closed if the bot/chat isn't reachable.
COMMUNITY_TG_CHAT_ID=

# ── Object storage (S3 / RustFS) ─────────────────────────
RUSTFS_ACCESS_KEY=rustfsadmin
RUSTFS_SECRET_KEY=rustfsadmin
S3_BUCKET=pandc

UMAMI_SRC=
UMAMI_WEBSITE_ID_WEB=
