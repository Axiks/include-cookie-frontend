# include-cookie-frontend — local environment
#
# Every section below is INDEPENDENTLY OPTIONAL. Copy this file to .env.local and fill in
# only the services you actually have running — the app starts and serves its static pages
# with none of this set. See the architecture table in README.md for exactly what each one
# unlocks and how the UI degrades without it.

# ── Catalog (REST) — the projects catalog itself: listings, project pages, home block ──
CATALOG_API_URL=http://localhost:3001
CATALOG_INTERNAL_KEY=

# ── Bot (REST) — optional: scope the whole catalog to one Telegram community's members.
# Leave COMMUNITY_TG_CHAT_ID blank to disable this entirely (default). ──
BOT_API_URL=http://localhost:8081
BOT_INTERNAL_KEY=
COMMUNITY_TG_CHAT_ID=

# ── Auth service (lumi-auth, REST) — batch identity lookup that hydrates contributor
# nicknames/avatars on project cards. This is the only service allowed to talk to the
# shared Kratos identity backend directly; this app never does so itself. Login itself
# (Kratos self-service, Hydra, NextAuth) was removed from this app — see
# archive/login-features in git history if you need it back. ──
AUTH_SERVICE_URL=http://localhost:8082
AUTH_INTERNAL_KEY=

# ── Object storage (S3-compatible, RustFS in dev) — serves the actual avatar/cover image
# bytes at /cdn/avatars/[id] and /cdn/covers/[id]. Missing/unreachable = broken image icons,
# not a crash. ──
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=pandc

# ── Misc ──
# Kill-switch for the read-only projects catalog (nav link, home block, /project pages).
# Unset/on = shown; off = hidden. Name predates the login-features removal (used to also
# gate Configurator/Members/Statistics/Sign-in — those are gone now, see
# archive/login-features), kept as-is to avoid an unrelated env rename.
DYNAMIC_FEATURES=on
# Client-side pageview script (public — rendered as a <script> tag when both are set)
UMAMI_SRC=
UMAMI_WEBSITE_ID_WEB=
# Build identifier shown in the UI. Auto-injected by the Docker build
# (--build-arg GIT_COMMIT=$(git rev-parse HEAD)) — leave blank locally, it falls back to
# reading your local git HEAD.
GIT_COMMIT=local
NODE_ENV=development
