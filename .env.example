# ── Database (own Postgres DB, pandc_web on the shared pandc-db server) ──
DATABASE_URL=postgresql://pandc:<password>@localhost:5432/pandc_web

# ── Catalog (REST) ──
CATALOG_API_URL=http://localhost:3001
CATALOG_INTERNAL_KEY=

# ── Bot (REST, community scoping) ──
BOT_API_URL=http://localhost:8081
BOT_INTERNAL_KEY=
COMMUNITY_TG_CHAT_ID=

# ── Identity (Ory Kratos, shared instance) ──
KRATOS_PUBLIC_URL=http://localhost:4433
KRATOS_ADMIN_URL=http://localhost:4434

# ── OAuth2 (Ory Hydra, shared instance — this app is the login/consent/logout UI) ──
HYDRA_ADMIN_URL=http://localhost:4445
HYDRA_ISSUER_URL=
FIRST_PARTY_CLIENT_IDS=

# ── NextAuth ──
AUTH_SECRET=
AUTH_URL=http://localhost:3000
WEBAUTHN_RP_ID=localhost

# ── Telegram ──
BOT_TOKEN=
BOT_NAME=
CHAT_GATE_ENABLED=
CHAT_GATE_CHAT_ID=

# ── Object storage (S3-compatible, RustFS in dev) ──
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=pandc

# ── Misc ──
DYNAMIC_FEATURES=on
UMAMI_SRC=
UMAMI_WEBSITE_ID_WEB=
GIT_COMMIT=local
NODE_ENV=development
