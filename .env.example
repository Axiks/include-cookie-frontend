# ── Catalog (REST) ──
CATALOG_API_URL=http://localhost:3001
CATALOG_INTERNAL_KEY=

# ── Bot (REST, community scoping) ──
BOT_API_URL=http://localhost:8081
BOT_INTERNAL_KEY=
COMMUNITY_TG_CHAT_ID=

# ── Auth service (REST) — still used for batch profile lookups that hydrate contributor
# avatars/nicknames on project cards (lib/kratos-identities.ts). Login itself (Kratos
# self-service, Hydra, NextAuth) was removed from this app — see archive/login-features. ──
AUTH_SERVICE_URL=http://localhost:8082
AUTH_INTERNAL_KEY=

# ── Object storage (S3-compatible, RustFS in dev) ──
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=pandc

# ── Misc ──
# Kill-switch for the read-only projects catalog (nav link, home block, /project pages).
# Unset/on = shown; off = hidden. Name predates the login-features removal (used to also
# gate Configurator/Members/Statistics/Sign-in — those are gone now, see
# archive/login-features), kept as-is to avoid an unrelated env rename.
DYNAMIC_FEATURES=on
# Client-side pageview script (public — rendered as a <script> tag when both are set)
UMAMI_SRC=
UMAMI_WEBSITE_ID_WEB=
GIT_COMMIT=local
NODE_ENV=development
