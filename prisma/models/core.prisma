model User {
  id                 String          @id @default(cuid())
  tgId               String?         @unique
  kratosId           String?         @unique
  nickname           String?
  about              String?
  links              UserLink[]
  stackVotes         UserStackVote[]
  isPassConfigurator Boolean         @default(false)

  name          String?
  email         String?         @unique
  emailVerified DateTime?
  avatars       UserAvatar[]
  covers        UserCover[]
  accounts      Account[]
  sessions      Session[]
  Authenticator Authenticator[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Stack {
  id    String          @id @default(cuid())
  name  String
  users UserStackVote[]
}

model UserStackVote {
  user             User   @relation(fields: [userId], references: [id])
  userId           String
  stack            Stack  @relation(fields: [stackId], references: [id])
  stackId          String
  engagementStatus String

  createdAt DateTime @default(now())

  @@id([userId, stackId])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
}

model Authenticator {
  credentialID         String  @unique
  userId               String
  providerAccountId    String
  credentialPublicKey  String
  counter              Int
  credentialDeviceType String
  credentialBackedUp   Boolean
  transports           String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, credentialID])
}

model UserLink {
  id        String   @id @default(cuid())
  name      String
  url       String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  User      User?    @relation(fields: [userId], references: [id])
  userId    String?
}

model Image {
  id  String @id @default(cuid())
  src String

  createdAt  DateTime     @default(now())
  UserAvatar UserAvatar[]
  UserCover  UserCover[]
}

model UserAvatar {
  user    User   @relation(fields: [userId], references: [id])
  userId  String
  image   Image  @relation(fields: [imageId], references: [id])
  imageId String

  index Int?

  @@id([userId, imageId])
}

model UserCover {
  user    User   @relation(fields: [userId], references: [id])
  userId  String
  image   Image  @relation(fields: [imageId], references: [id])
  imageId String

  index Int?

  @@id([userId, imageId])
}

model PasskeyCredential {
  id           String   @id @default(cuid())
  credentialId String   @unique
  publicKey    String
  signCount    Int      @default(0)
  kratosId     String

  createdAt DateTime @default(now())
}
