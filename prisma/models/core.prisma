model User {
  id                 String          @id @default(cuid())
  tgId               String?         @unique
  kratosId           String?         @unique
  nickname           String?
  about              String?
  links              UserLink[]
  stackVotes         UserStackVote[]
  isPassConfigurator Boolean         @default(false)

  name          String?
  email         String?         @unique
  emailVerified DateTime?
  avatars       UserAvatar[]
  covers        UserCover[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Stack {
  id    String          @id @default(cuid())
  name  String
  users UserStackVote[]
}

model UserStackVote {
  user             User   @relation(fields: [userId], references: [id])
  userId           String
  stack            Stack  @relation(fields: [stackId], references: [id])
  stackId          String
  engagementStatus String

  createdAt DateTime @default(now())

  @@id([userId, stackId])
}

model UserLink {
  id        String   @id @default(cuid())
  name      String
  url       String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  User      User?    @relation(fields: [userId], references: [id])
  userId    String?
}

model Image {
  id  String @id @default(cuid())
  src String

  createdAt  DateTime     @default(now())
  UserAvatar UserAvatar[]
  UserCover  UserCover[]
}

model UserAvatar {
  user    User   @relation(fields: [userId], references: [id])
  userId  String
  image   Image  @relation(fields: [imageId], references: [id])
  imageId String

  index Int?

  @@id([userId, imageId])
}

model UserCover {
  user    User   @relation(fields: [userId], references: [id])
  userId  String
  image   Image  @relation(fields: [imageId], references: [id])
  imageId String

  index Int?

  @@id([userId, imageId])
}

model PasskeyCredential {
  id           String   @id @default(cuid())
  credentialId String   @unique
  publicKey    String
  signCount    Int      @default(0)
  kratosId     String

  createdAt DateTime @default(now())
}
