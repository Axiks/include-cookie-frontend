{
  "name": "pandc-web",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "next start",
    "dev": "next dev --turbopack",
    "build": "next build",
    "lint": "eslint .",
    "prisma:init": "npx prisma validate --schema prisma/ && npx prisma generate --schema prisma/ && npx prisma db push --schema prisma/",
    "prisma:push": "npx prisma db push --schema prisma/ --skip-generate",
    "prisma:deploy": "npx prisma migrate deploy --schema prisma/ && prisma migrate status --schema prisma/",
    "prisma:seed": "tsx prisma/seed.ts",
    "prisma:seed:fake": "tsx prisma/seed-fake.ts",
    "prisma:seed:fake:clean": "tsx prisma/seed-fake.ts --clean",
    "prisma:validate": "npx prisma validate --schema prisma/",
    "prisma:studio": "npx prisma studio --schema prisma/",
    "test": "vitest run",
    "test:watch": "vitest"
  },
